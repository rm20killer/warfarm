{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warfarm",
  "main": "../src/worker.ts",
  "compatibility_date": "2026-09-10",
  "kv_namespaces": [
		{
			"binding": "WARFRAME_CACHE",
			"id": "8ccdd1dfe2fe4ca59cc0725b1929950a"
		},
	],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "not_found_handling": "single-page-application"
  }
}
